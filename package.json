{
  "name": "threadhelm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript7/bin/tsc --build --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "rust:check": "cargo clippy --manifest-path native/windows-supervisor/Cargo.toml --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path native/windows-supervisor/Cargo.toml --check",
    "rust:test": "cargo test --manifest-path native/windows-supervisor/Cargo.toml",
    "native:build": "pnpm --filter @threadhelm/windows-supervisor build",
    "test:integration:windows": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:acceptance:installed": "vitest run --project acceptance tests/acceptance/installed-app.test.ts",
    "test:smoke:providers": "vitest run --project acceptance tests/acceptance/provider-smoke.test.ts",
    "native:test": "cargo test --manifest-path native/windows-supervisor/Cargo.toml",
    "desktop:build": "pnpm --filter @threadhelm/desktop build",
    "dev": "pnpm --filter @threadhelm/desktop dev",
    "proof:windows-supervision": "pnpm desktop:build && vitest run --project integration tests/integration/windows/job-object-proof.test.ts",
    "package:win": "pnpm desktop:build && pnpm --filter @threadhelm/desktop make",
    "native:build:debug": "pnpm --filter @threadhelm/windows-supervisor build:debug"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.8.6",
    "@playwright/test": "^1.62.1",
    "@threadhelm/contracts": "workspace:*",
    "@threadhelm/domain": "workspace:*",
    "@threadhelm/persistence": "workspace:*",
    "@threadhelm/providers": "workspace:*",
    "@threadhelm/test-fixtures": "workspace:*",
    "@threadhelm/windows-supervisor": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "globals": "^17.11.0",
    "node-addon-api": "^8.9.2",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.11"
  }
}
