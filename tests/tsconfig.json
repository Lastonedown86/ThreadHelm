{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "references": [
    {
      "path": "../packages/contracts"
    },
    {
      "path": "../packages/domain"
    },
    {
      "path": "../packages/persistence"
    },
    {
      "path": "../packages/providers"
    },
    {
      "path": "../packages/test-fixtures"
    },
    {
      "path": "../apps/desktop"
    }
  ],
  "exclude": ["unit/renderer"]
}
